# Database Configuration
# Default PostgreSQL URL for local dev or production
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/calling_agent
# Dual fallback to SQLite if PostgreSQL is not active locally
USE_SQLITE_FALLBACK=true

# AI Configuration (Google Gemini / OpenAI / Groq / Ollama / Built-in Agent Engine)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash

# Telephony Configuration (Twilio Free/Trial Account)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
SERVER_PUBLIC_URL=http://localhost:8000

# Voice / Audio Settings
DEFAULT_TTS_VOICE=en-IN-PrabhatNeural
DEFAULT_STT_LANGUAGE=en-IN

# App Config
SECRET_KEY=super-secret-key-change-in-production
DEBUG=True
